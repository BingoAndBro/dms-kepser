// Flow graph fungsi transition() pada src/lib/fsm.ts (baris 81-127)
// Basis path testing (Pressman, 2010): kondisi majemuk dipecah satu simpul per kondisi.
// Simpul diarsir = simpul predikat. Label sisi: T = benar, F = salah.
// Rincian simpul dan sisi: basis-path-fsm.md bagian 1.
digraph transition {
  graph [fontname="Arial", nodesep=0.45, ranksep=0.32, pad=0.2, splines=true];
  node  [shape=circle, fixedsize=true, width=0.42, fontname="Arial", fontsize=12, style=solid];
  edge  [fontname="Arial", fontsize=10, arrowsize=0.6];

  // Simpul predikat (10)
  1, 3, 4, 5, 6, 8, 9, 11, 12, 14 [style=filled, fillcolor="#c8c8c8"];

  // Simpul biasa (7)
  2; 7; 10; 13; 15; 16; 17;

  1  -> 2  [label="T"];
  1  -> 3 [label="F"];
  2  -> 17;
  3  -> 4  [label="T"];
  3  -> 8  [label="F"];
  4  -> 7  [label="T"];
  4  -> 5  [label="F"];
  5  -> 6  [label="T"];
  5  -> 8  [label="F"];
  6  -> 7  [label="T"];
  6  -> 8  [label="F"];
  7  -> 17;
  8  -> 9  [label="T"];
  8  -> 11 [label="F"];
  9  -> 10 [label="T"];
  9  -> 11 [label="F"];
  10 -> 17;
  11 -> 12 [label="T"];
  11 -> 14 [label="F"];
  12 -> 13 [label="T"];
  12 -> 14 [label="F"];
  13 -> 17;
  14 -> 15 [label="T"];
  14 -> 16 [label="F"];
  15 -> 17;
  16 -> 17;
}
